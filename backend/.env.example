# Optional: language model for question generation and detailed answer feedback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: public web search for company/role research; never put in VITE_ variables
BRAVE_SEARCH_API_KEY=
# Local default: SQLite in backend/interviewiq.db
DATABASE_PATH=./interviewiq.db
# Production: hosted PostgreSQL (Supabase/Neon/etc). DATABASE_URL takes precedence.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Allowed frontend origin(s), comma separated; no trailing slash
FRONTEND_ORIGIN=http://localhost:5173
